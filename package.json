{
  "name": "astro-toolbox",
  "version": "0.1.7",
  "private": true,
  "author": "Maple",
  "description": "AstroToolbox desktop app built with Electron, Vue 3, TypeScript and Ant Design Vue.",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:build\" \"npm:dev:electron:launch\"",
    "dev:renderer": "vite",
    "dev:electron:build": "tsc -p tsconfig.node.json --watch",
    "dev:electron:launch": "wait-on tcp:5173 dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon --watch dist-electron --ext js --exec electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.node.json",
    "pack": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.astro.toolbox",
    "productName": "AstroToolbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "user",
        "to": "user",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      }
    ],
    "icon": "public/icon.ico",
    "publish": [
      {
        "provider": "generic",
        "url": "https://init"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.svg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.svg"
    }
  },
  "dependencies": {
    "ant-design-vue": "^4.2.6",
    "electron-updater": "^6.8.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.1.10",
    "wait-on": "^8.0.1"
  }
}

